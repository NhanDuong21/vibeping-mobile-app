    "/api/v1/events": {
      "get": {
        "tags": [
          "activity_http"
        ],
        "operationId": "events",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "grouped",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "project",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated activity feed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventFeed"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor or limit"
          }
        }
      }
    },
    "/api/v1/events/read-all": {
      "post": {
        "tags": [
          "activity_http"
        ],
        "operationId": "read_all",
        "responses": {
          "200": {
