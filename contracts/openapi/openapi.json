      }
    },
    "/api/v1/events/{id}/read": {
      "post": {
        "tags": [
          "activity_http"
        ],
        "operationId": "read_event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Activity event identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "through",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activity event marked read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadStateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Activity event not found"
          }
        }
      }
    },
