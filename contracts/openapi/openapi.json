    "/api/v1/events/{id}": {
      "get": {
        "tags": [
          "activity_http"
        ],
        "operationId": "event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Activity event identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activity event detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityEventDetail"
                }
              }
            }
          },
          "404": {
            "description": "Activity event not found"
          }
