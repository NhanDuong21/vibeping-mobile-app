  "components": {
    "schemas": {
      "ActionResponse": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string"
          }
        }
      },
      "ActivityEvent": {
        "type": "object",
        "required": [
          "id",
          "eventType",
          "title",
          "summary",
          "projectName",
          "occurredAt",
          "isRead"
        ],
        "properties": {
          "eventType": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "isRead": {
            "type": "boolean"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "projectName": {
            "type": "string"
          },
          "resultExcerpt": {
            "type": [
              "string",
              "null"
            ]
          },
          "session": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/WorkSession"
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ActivityEventDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ActivityEvent"
          },
          {
            "type": "object",
            "required": [
              "timeline"
            ],
            "properties": {
              "result": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/CodexResult"
                  }
                ]
              },
              "timeline": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ActivityTimelineStage"
                }
              }
            }
          }
        ]
      },
      "ActivitySnapshot": {
        "type": "object",
        "required": [
          "events",
          "cursor"
        ],
        "properties": {
          "currentWork": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrentWork"
              }
            ]
          },
          "cursor": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityEvent"
            }
          }
        }
      },
      "ActivityTimelineStage": {
        "type": "object",
        "required": [
          "eventType",
          "occurredAt"
        ],
        "properties": {
          "eventType": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BootstrapResponse": {
        "type": "object",
        "required": [
          "serverTime",
          "connection",
          "cursor",
          "usageLimits",
          "unreadCount"
        ],
        "properties": {
          "connection": {
            "$ref": "#/components/schemas/ConnectionSnapshot"
          },
          "currentWork": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrentWork"
              }
            ]
          },
          "cursor": {
            "type": "string"
          },
          "serverTime": {
            "type": "string"
          },
          "unreadCount": {
            "type": "integer",
            "format": "int64"
          },
          "usageLimits": {
            "$ref": "#/components/schemas/UsageLimitsSnapshot"
          }
        }
      },
      "BrowserSubscription": {
        "type": "object",
        "required": [
          "endpoint",
          "keys"
        ],
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "expirationTime": {},
          "keys": {
            "$ref": "#/components/schemas/SubscriptionKeys"
          }
        }
      },
      "CodexResult": {
        "type": "object",
        "required": [
          "text",
          "truncated"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "ComputerStatus": {
        "type": "object",
        "required": [
          "desktop",
          "codex",
          "allowanceReader",
          "notifications",
          "privateConnection",
          "startedAt"
        ],
        "properties": {
          "allowanceReader": {
            "type": "string"
          },
          "codex": {
            "type": "string"
          },
          "desktop": {
            "type": "string"
          },
          "lastSignalAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "notifications": {
            "type": "string"
          },
          "privateConnection": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConnectionSnapshot": {
        "type": "object",
        "required": [
          "desktop",
          "codex",
          "privateConnection"
        ],
        "properties": {
          "codex": {
            "type": "string"
          },
          "desktop": {
            "type": "string"
          },
          "privateConnection": {
            "type": "string"
          }
        }
      },
      "CurrentWork": {
        "type": "object",
        "required": [
          "projectName",
          "state",
          "lastTestState",
          "previewReady",
          "startedAt",
          "updatedAt",
          "freshUntil"
        ],
        "properties": {
          "freshUntil": {
            "type": "string",
            "format": "date-time"
          },
          "lastTestState": {
            "type": "string"
          },
          "previewReady": {
            "type": "boolean"
          },
          "projectName": {
            "type": "string"
          },
          "sessionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DailySummary": {
        "type": "object",
        "required": [
          "sessions",
          "completed",
          "failedTests",
          "observedSeconds"
        ],
        "properties": {
          "completed": {
            "type": "integer",
            "format": "int64"
          },
          "failedTests": {
            "type": "integer",
            "format": "int64"
          },
          "observedSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "sessions": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "DiagnosticCheck": {
        "type": "object",
        "required": [
          "key",
          "label",
          "state",
          "detail"
        ],
        "properties": {
          "action": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "DiagnosticsReport": {
        "type": "object",
        "required": [
          "generatedAt",
          "checks",
          "technicalReport"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiagnosticCheck"
            }
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "technicalReport": {
            "type": "string"
          }
