    "/api/v1/usage-limits/refresh": {
      "post": {
        "tags": [
          "usage_limits_http"
        ],
        "operationId": "refresh_limits",
        "responses": {
          "200": {
            "description": "Refreshed Codex allowance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageLimitsSnapshot"
                }
              }
            }
          },
          "503": {
            "description": "Codex allowance reader unavailable"
